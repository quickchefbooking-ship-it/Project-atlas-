# AtlasOnePro / Professor local development settings
ATLAS_DB_PATH=atlas.db
ATLAS_API_KEY=
ATLAS_ENABLE_PAID_AI=false

# Require authentication for private API routes by default.
ATLAS_API_REQUIRE_AUTH=true

# Professor capability execution is globally disabled unless explicitly opted in.
# Set true only in a controlled environment after identity and safety review.
ATLAS_CAPABILITY_EXECUTION_ENABLED=false


# Hosted browser login is disabled unless every setting below is supplied.
# Register this exact callback URI with the selected OIDC provider.
# Use provider-pinned HTTPS endpoints; Atlas does not perform discovery.
# ATLAS_OIDC_ISSUER=https://identity.example.test
# ATLAS_OIDC_AUDIENCE=atlas-api
# ATLAS_OIDC_JWKS_URI=https://identity.example.test/.well-known/jwks.json
# ATLAS_OIDC_ALLOWED_ALGORITHMS=RS256
# ATLAS_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.test/authorize
# ATLAS_OIDC_TOKEN_ENDPOINT=https://identity.example.test/token
# ATLAS_OIDC_CLIENT_ID=registered-atlas-browser-client
# ATLAS_OIDC_REDIRECT_URI=https://atlas.example.test/identity/callback
# ATLAS_OIDC_CLIENT_SECRET=  # Optional; leave unset for a public PKCE client.
#
# Keep these file-backed stores separate from ATLAS_DB_PATH and from each other.
# ATLAS_ACCOUNT_DB_PATH=./data/atlas-accounts.sqlite
# ATLAS_MEMBERSHIP_DB_PATH=./data/atlas-memberships.sqlite
# ATLAS_OIDC_LOGIN_TRANSACTION_DB_PATH=./data/atlas-oidc-login-transactions.sqlite
# Generate a dedicated 32-byte key and store its 64-character hex form in secrets.
# Example generation command: openssl rand -hex 32
# ATLAS_OIDC_LOGIN_TRANSACTION_KEY_HEX=

# Optional media-source credentials
ATLAS_MEDIA_UNSPLASH_ACCESS_KEY=
ATLAS_MEDIA_PEXELS_API_KEY=

# Generated media and temporary files
ATLAS_MEDIA_OUTPUT_DIR=./output
ATLAS_MEDIA_TMP_DIR=./tmp

# Professor reasoning provider is disabled by default.
# For a self-hosted OpenAI-compatible service running on the SAME machine
# as Atlas, uncomment and adjust these settings after local testing.
# Example: Ollama exposes /v1/chat/completions on loopback.
# ATLAS_LLM_PROVIDER=openai_compatible
# ATLAS_LLM_CHAT_COMPLETIONS_URL=http://127.0.0.1:11434/v1/chat/completions
# ATLAS_LLM_MODEL=replace-with-the-exact-local-model-name
# ATLAS_LLM_TIMEOUT_SECONDS=30
# ATLAS_LLM_MAX_RESPONSE_CHARS=12000
# ATLAS_LLM_API_KEY=

# No paid AI provider is enabled by default.
ATLAS_LLM_PROVIDER=off
OPENAI_API_KEY=
