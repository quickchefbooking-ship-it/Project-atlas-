# AtlasOnePro / Professor local development settings
ATLAS_DB_PATH=atlas.db
ATLAS_API_KEY=replace-with-a-long-random-secret
ATLAS_ENABLE_PAID_AI=false

# Require authentication for private API routes by default.
ATLAS_API_REQUIRE_AUTH=true

# Optional media-source credentials
ATLAS_MEDIA_UNSPLASH_ACCESS_KEY=
ATLAS_MEDIA_PEXELS_API_KEY=

# Generated media and temporary files
ATLAS_MEDIA_OUTPUT_DIR=./output
ATLAS_MEDIA_TMP_DIR=./tmp

# No paid AI provider is enabled by default.
OPENAI_API_KEY=
