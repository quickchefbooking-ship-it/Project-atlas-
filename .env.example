# AtlasOnePro / Professor local development settings
ATLAS_DB_PATH=atlas.db
ATLAS_API_KEY=
ATLAS_ENABLE_PAID_AI=false

# Require authentication for private API routes by default.
ATLAS_API_REQUIRE_AUTH=true

# Optional media-source credentials
ATLAS_MEDIA_UNSPLASH_ACCESS_KEY=
ATLAS_MEDIA_PEXELS_API_KEY=

# Generated media and temporary files
ATLAS_MEDIA_OUTPUT_DIR=./output
ATLAS_MEDIA_TMP_DIR=./tmp

# Professor reasoning provider is disabled by default.
# For a self-hosted OpenAI-compatible service running on the SAME machine
# as Atlas, uncomment and adjust these settings after local testing.
# Example: Ollama exposes /v1/chat/completions on loopback.
# ATLAS_LLM_PROVIDER=openai_compatible
# ATLAS_LLM_CHAT_COMPLETIONS_URL=http://127.0.0.1:11434/v1/chat/completions
# ATLAS_LLM_MODEL=replace-with-the-exact-local-model-name
# ATLAS_LLM_TIMEOUT_SECONDS=30
# ATLAS_LLM_MAX_RESPONSE_CHARS=12000
# ATLAS_LLM_API_KEY=

# No paid AI provider is enabled by default.
ATLAS_LLM_PROVIDER=off
OPENAI_API_KEY=
